# Stage 3 authentication requires the two public Supabase values below.
# Landing pages and local tests still run without an external service.
# Next.js reads apps/web/.env.local, not the repository-root .env.
# Copy the WEB section there after creating a Supabase project. See docs/supabase-setup.md.

# WEB: public Supabase configuration (safe for browser use with RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WEB: server-only analytics URL.
# Never prefix service-role keys or other private secrets with NEXT_PUBLIC_.
ANALYTICS_API_URL=http://127.0.0.1:8000

# WEB + ANALYTICS: same server-only key in both local environment files.
# Generate a random value with at least 32 characters. Never commit or expose it.
ANALYTICS_API_KEY=

# WEB + ANALYTICS: actual request-byte limit (default 20 MiB; maximum 100 MiB).
MAX_UPLOAD_SIZE_BYTES=20971520

# ANALYTICS: maximum CSV data rows, excluding the header and physically blank rows.
MAX_DATASET_ROWS=100000

# ANALYTICS: copy the key, upload/row limits, and CORS_ORIGINS to apps/analytics/.env.
# JSON array of exact HTTP(S) origins; [] disables browser cross-origin access.
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
