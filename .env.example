# Stage 1 runs without environment variables or external services.
# Reserved for later stages; none of these values are consumed yet.
# Next.js reads apps/web/.env.local, not the repository-root .env.
# Copy the WEB section there when authentication/API integration is implemented.

# WEB: public Supabase configuration (safe for browser use with RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WEB: server-only analytics service URL. Never prefix secrets with NEXT_PUBLIC_.
ANALYTICS_API_URL=http://127.0.0.1:8000

# WEB + ANALYTICS: enforce the same byte limit on both services in the upload stage.
MAX_UPLOAD_SIZE_BYTES=20971520

# ANALYTICS: reserved for apps/analytics/.env when FastAPI is initialized.
MAX_DATASET_ROWS=100000
CORS_ORIGINS=http://localhost:3000
